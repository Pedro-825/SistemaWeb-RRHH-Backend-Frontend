{
  "routes": [
    {
      "route": "/api/*",
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "rewrite": "/api/*",
      "backendUri": "${BACKEND_URL}/api/*"
    },
    {
      "route": "/uploads/*",
      "rewrite": "/uploads/*",
      "backendUri": "${BACKEND_URL}/uploads/*"
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/uploads/*", "/*.{css,js,png,svg,ico,json}"]
  },
  "globalHeaders": {
    "Cache-Control": "no-store"
  }
}
